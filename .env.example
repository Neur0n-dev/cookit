# cookit 백엔드 환경 변수 목록 (값은 비워 두고, 실제 값은 .env 또는 GitHub Secrets에 입력)
# 항목 이름은 07 애플리케이션 개발 시 확정

# ===== 실행 프로필 =====
# dev: 개발 PC, prod: 운영 서버
SPRING_PROFILES_ACTIVE=dev

# ===== DB (운영은 WAS 안의 HAProxy localhost:3306으로 접속) =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cookit
DB_USERNAME=
DB_PASSWORD=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 인증 =====
# JWT 서명 키 (비어 있으면 서버 시작 차단)
JWT_SECRET=

# ===== Gemini =====
GEMINI_API_KEY=

# ===== 테스트용 설정 (부하 테스트 중에만 변경, 기본값 유지) =====
# true면 Gemini 대신 mock 응답 사용
GEMINI_MOCK_ENABLED=false
# false면 추천 횟수 제한 해제
RATE_LIMIT_ENABLED=true
